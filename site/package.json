{
  "name": "reflections-studio",
  "private": true,
  "version": "1.0.0",
  "description": "Reflections public site plus the protected AI chapter production studio (server code under api/).",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "verify": "npm run lint && npm run typecheck && npm test && npm run check:bundle",
    "check:bundle": "node scripts/check-bundle.mjs",
    "dev": "node --experimental-transform-types --no-warnings scripts/dev-server.ts",
    "hash-password": "node --experimental-transform-types --no-warnings scripts/hash-password.ts"
  },
  "dependencies": {
    "@vercel/blob": "^2.9.0",
    "@vercel/functions": "^3.11.3",
    "openai": "^7.59.0",
    "pg": "^8.23.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@electric-sql/pglite": "^0.5.16",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "axe-core": "^4.14.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.0"
  }
}
